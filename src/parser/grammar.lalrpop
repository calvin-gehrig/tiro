use crate::common::{
    Statement,
    Expression,
    Parameter
};

use crate::lexer::{
    token::Token,
    error::LexingError
};

grammar;

extern {
    type Location = usize;
    type Error = LexingError;

    enum Token {
        "id" => Token::Identifier(<String>),
        "echo" => Token::Echo,
        "sit" => Token::Sit,
        "catena" => Token::Catena(<String>),
        "fvnctio" => Token::Functio,
        "reddi" => Token::Reddi,
        "voc" => Token::Voc,
        "(" => Token::LeftParan,
        ")" => Token::RightParan,
        "," => Token::Comma,
        "=>" => Token::RightArrow,
        ":" => Token::Column
    }
}

pub Program: Vec<Statement> = {
    <stmts:Stmt*> => stmts
}

Stmt: Statement = {
    StmtPrint,
    StmtVariableDeclaration,
    StmtFunctionDeclaration,
    CallStmt
}

StmtPrint: Statement = {
    "echo" <Expr> => Statement::Print {value: <>}
}

StmtVariableDeclaration : Statement = {
    "sit" <varname:"id"> ":" <vartype:"id"?> <varvalue:Expr> => Statement::VariableDeclaration {
        value: varvalue,
        variable_type: vartype,
        identifier: varname
    }
}

StmtFunctionDeclaration : Statement = {
    "fvnctio" <funcname:"id"> "(" <mut param_list: (<ParamDef> ",")*>
        <last_param:ParamDef?> ")"
        <return_type:FunctionReturnType?> <mut block:Program>
        <mut return_stmt:ReturnStmt> => Statement::FunctionDeclaration {
            identifier: funcname.clone(),
            param_list: match last_param {
                Some(param) => {
                    param_list.push(param);
                    param_list
                },
                None => param_list
            },
            return_type,
            block: {
                if let Statement::ReturnStatement {function,..} = &mut return_stmt {
                    *function = funcname;
                }
                block.push(return_stmt);
                Box::new(block)
            }
        }
}

ParamDef : Parameter = {
    <name:"id"> ":" <param_type:"id"> => Parameter {
            identifier: name,
            param_type: param_type
        }
}

FunctionReturnType : String = {
    "=>" <"id"> => <>
}

ReturnStmt : Statement = {
    "reddi" <return_value:Expr?> => Statement::ReturnStatement {
        return_value,
        function: String::default()
    }
}

CallStmt : Statement = {
    "voc" <Expr> => Statement::Call {expression:<>}
}

Expr: Expression = {
    #[precedence(level="1")]
    ExprValue,
    #[precedence(level="2")]
    FuncCall
}

ExprValue: Expression = {
    "catena" => Expression::StringValue {value: <>},
    "id" => Expression::Variable {identifier: <>}
}

FuncCall: Expression = {
    <name:"id"> "(" <mut args: (<Expr> ",")*> <last_arg:Expr?> ")" =>
            Expression::FunctionCall {
                identifier: name,
                argument_list: match last_arg {
                    Some(arg) => {
                        args.push(arg);
                        Box::new(args)
                    },
                    None => Box::new(args)
                }
            }
}


